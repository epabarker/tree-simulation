+/// True if the vigour response (proposal B, fresh-look beech) is on.
+pub fn vigour_on(r2: &R2) -> bool {
+    r2.enabled && r2.vigour_share > 0.0
+}
+
+/// The vigour response's u in [0, 1]: the share of the tree's resource `v_base` that flows through
+/// a node this season (`v_in`), against r2.vigourShare. Troll's model: every axis is plagiotropic
+/// and straightens secondarily (Hallé et al. 1978); in beech, vigorous axes are orthotropic and
+/// weak ones plagiotropic (Nicolini 2000), and forks form where growth is weak or very strong
+/// (Nicolini & Caraglio 1994). So weak wood (u → 0) loses apical control (λ falls by
+/// (1 − u)·vigourLambda, C3) and keeps its level's plagiotropic growth set point as its posture
+/// target (R3), while wood that carries a large share of its tree (u → 1, a bole) keeps λ and
+/// straightens toward vigourSetPoint. A narrow stand crown passes most of its resource up its
+/// leader, which stays a bole; a broad open crown spreads it over many limbs, so its top divides
+/// and leans out: the trunk is lost in the crown as the crown grows.
+pub fn vigour(v_in: f64, v_base: f64, r2: &R2) -> f64 {
+    if v_base <= 0.0 {
+        return 0.0;
+    }
+    math::max(0.0, math::min(1.0, v_in / v_base / r2.vigour_share))
+}
+
+/// The tree's vigour gate g in [0, 1] by its resource `v_base` (1 when no gate is set).
+pub fn vigour_gate(v_base: f64, r2: &R2) -> f64 {
+    if r2.vigour_tree_hi <= r2.vigour_tree_lo {
+        return 1.0;
+    }
+    math::max(
+        0.0,
+        math::min(1.0, (v_base - r2.vigour_tree_lo) / (r2.vigour_tree_hi - r2.vigour_tree_lo)),
+    )
+}
+
+/// The posture set point (radians) of wood of vigour `u` on an axis of physiological age `pa`
+/// whose offsets (curve, age) add `bend` radians: from the level's growth set point (weak) to
+/// r2.vigourSetPoint (vigorous), within [0, π].
+pub fn vigour_posture(pa: f64, bend: f64, u: f64, params: &Params) -> f64 {
+    let deg = crate::params::DEG;
+    let weak = direction_params(params, pa).set_point * deg + bend;
+    let target = weak + u * (params.r2.vigour_set_point * deg - weak);
+    math::max(0.0, math::min(std::f64::consts::PI, target))
+}
