digraph growth {
  rankdir=LR; node [shape=box, fontsize=10];
  subgraph "cluster_Light" { label="Light";
    OBST [label="Obstacles: shed branches inside obstacles"];
    STORM [label="O2 storm draw (one per season)"];
    C2_LIGHT [label="C2 deposit foliage + Beer-Lambert sky sweep"];
    O2_TAG [label="O2 owner grid (whose foliage is where)"];
  }
  subgraph "cluster_Sample" { label="Sample";
    C2_SAMPLE [label="C2 sample Q, V at every live bud"];
    R5_SHADE [label="R5 shade s = 1 - Q/C (x neighbours' share)"];
    R2_CROWD [label="R2 relay gate signal s-bar (mean neighbour shade)"];
    C5_QTOP [label="C5 crown-top light Q_top (quantile of bud Q)"];
  }
  subgraph "cluster_Allocate" { label="Allocate";
    C3_BASI [label="C3 basipetal light sum Q_sum, n_b, Q_base"];
    R1_CARBON [label="R1 carbon balance P - M -> reserve, seeds, v_base"];
    C3_ACRO [label="C3 Borchert-Honda split (lambda by R2/R5/vigour drop)"];
  }
  subgraph "cluster_Grow" { label="Grow";
    R4_FATE [label="R4 bud fate: threshold, light release, stochastic break"];
    R2_FORM [label="R2 form: pa, relay, fork, set-point modifiers, p_term"];
    C4_DIR [label="C4 shoot direction (tropism, light, noise)"];
    C1_SHOOT [label="C1 shoot size, phyllotaxis, new metamers + buds"];
    R6_REST [label="R6 resting fate: short shoot / dormant / abort"];
  }
  subgraph "cluster_Shed" { label="Shed";
    C5_SHED [label="C5 self-pruning (carbon deficit or light)"];
  }
  subgraph "cluster_Girth" { label="Girth";
    C6_GIRTH [label="C6 pipe-model girth with scars"];
  }
  subgraph "cluster_Mechanics" { label="Mechanics";
    R3_MECH [label="R3 sag, posture, stress wood, breakage, windthrow"];
  }
  subgraph "cluster_Commit" { label="Commit";
    COMMIT [label="Commit: compact buds, tree age + 1"];
  }
  subgraph "cluster_Deaths" { label="Deaths";
    O2_ABRADE [label="O2 abrasion (crown shyness)"];
    R1_STARVE [label="R1 starvation death (k_starve empty seasons)"];
    O4_STAND [label="O4 stand dynamics: m0, seeds, establishment"];
  }
  C2_LIGHT -> R5_SHADE [style=solid, label="light", fontsize=7];
  C2_LIGHT -> O4_STAND [style=solid, label="light", fontsize=7];
  C2_LIGHT -> C2_SAMPLE [style=solid, label="light", fontsize=7];
  O2_TAG -> O2_ABRADE [style=solid, label="owner", fontsize=7];
  O2_TAG -> R5_SHADE [style=solid, label="owner", fontsize=7];
  STORM -> R3_MECH [style=solid, label="storm", fontsize=7];
  C2_SAMPLE -> R4_FATE [style=solid, label="budq", fontsize=7];
  C2_SAMPLE -> O2_ABRADE [style=solid, label="budq", fontsize=7];
  C2_SAMPLE -> R1_CARBON [style=solid, label="budq", fontsize=7];
  C2_SAMPLE -> C5_QTOP [style=solid, label="budq", fontsize=7];
  C2_SAMPLE -> C4_DIR [style=solid, label="budq", fontsize=7];
  C2_SAMPLE -> R6_REST [style=solid, label="budq", fontsize=7];
  C2_SAMPLE -> R2_FORM [style=solid, label="budq", fontsize=7];
  C2_SAMPLE -> C3_BASI [style=solid, label="budq", fontsize=7];
  R5_SHADE -> C3_ACRO [style=solid, label="shade", fontsize=7];
  R5_SHADE -> R4_FATE [style=solid, label="shade", fontsize=7];
  R5_SHADE -> C1_SHOOT [style=solid, label="shade", fontsize=7];
  R5_SHADE -> C4_DIR [style=solid, label="shade", fontsize=7];
  R5_SHADE -> R2_CROWD [style=solid, label="shade", fontsize=7];
  R2_CROWD -> R2_FORM [style=solid, label="crowd", fontsize=7];
  C5_QTOP -> C5_SHED [style=solid, label="qtop", fontsize=7];
  C3_BASI -> C3_ACRO [style=solid, label="qsum", fontsize=7];
  C3_BASI -> C5_SHED [style=solid, label="qsum", fontsize=7];
  R1_CARBON -> C5_SHED [style=solid, label="PM,vbase", fontsize=7];
  R1_CARBON -> R4_FATE [style=solid, label="reserve", fontsize=7];
  R4_FATE -> R1_CARBON [style=dashed, color=gray50, constraint=false, label="reserve,budstate", fontsize=7];
  R1_CARBON -> R1_STARVE [style=solid, label="starved", fontsize=7];
