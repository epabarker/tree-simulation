 "constants": {
  "close": 0.5,
  "cost": 2.0,
  "noise_se": 2.0,
  "spread_ok": 1.0,
  "boot_seed": 20261109,
  "boot_n": 2000,
  "top_descriptors": 3,
  "top_knobs": 3
 },
 "rules": {
  "unit": "Δz = z_condition − z_hand: the median of the detrended simulated trees, in real between-tree SDs (v3's real distributions); its SE from a paired bootstrap over the 10 seeds (BOOT_N resamples, numpy seed BOOT_SEED; the same seed draw for every condition; medians and the Level 0 sum recomputed, the matched season held)",
  "move": "m = −sign(z_hand) · Δz (toward the target is positive); f = m / |z_hand|, the fraction of the hand's gap closed. f ≥ 1 is reported as a bracket: the target crossed between two adjacent grid points on the knob's side, with ΔL0 as the range at those points (a bound may be a regime change: continuity is not assumed). Beside f, its bootstrap 5th percentile",
  "cost": "ΔL0 = the condition's Level 0 sum (loss − Σ fitted location terms; Level 0's scored traits and death penalties at their Level 0 weights) − the hand's; beside it ΔL0 without stand.lateShare; each with its bootstrap SE",
  "reach": "per descriptor, over the matched single-knob conditions: the largest f and the ΔL0 of that move. Verdicts: 'at target within noise' if |z_hand| < NOISE_SE · SE(z_hand); else 'unreachable by single-knob moves' if no condition has f > CLOSE; else 'reachable at cost' if the cheapest condition with f > CLOSE raises Level 0 by more than COST; else 'reachable'",
  "unmatched": "an unmatched or dead condition contributes no descriptor values; it is counted and greyed. Cells of a condition flagged 'matched at the first season' or 'trees outside the real DBH range' are marked",
  "spread": "per descriptor: s = log2(sim SD / real SD); the largest single-knob rise of s toward 0, −sign(s_hand) · (s − s_hand), and whether any matched condition has |s| ≤ SPREAD_OK",
  "pairs": "the TOP_DESCRIPTORS descriptors (not at target within noise) with the largest remaining gap max(0, |z_hand| − max(0, m_best)), held out included; for each, its TOP_KNOBS single-knob movers (each knob's best matched non-hand point v* by m; knobs with m > 0, ranked by it); v½ halfway between the hand and v* on the knob's scale (u); for each pair (A ranked above B): (v*_A, v*_B), (v*_A, v½_B), (v½_A, v*_B). Identical conditions are measured once. Reported: the best pair's f and ΔL0, and its departure from additivity (Δz − Δz_A − Δz_B) where both singles are grid points",
  "envelope": "pilot v2's 120 candidates (registration v3, the same 10 seeds, joint form-knob moves; the checkpoint, read-only): per fitted descriptor the best f, that candidate's ΔL0 and its spread s, flagged when s < −1. Held-out descriptors have no pilot data",
  "verdict": "'needs a rule rather than a knob' only where the single-knob sweep, the pair check (where run for the descriptor) and the envelope (fitted descriptors) all fall short of f = CLOSE. Elsewhere: 'reached by a single knob' (with the cost verdict), 'reached jointly (pair check | pilot v2 envelope)', or 'not reached by the knobs tested; joint moves untested' where no joint evidence exists",
  "not_covered": "interactions outside the top-three pairs; compensated reach (a move stopped by a regime boundary that a second knob lifts) across the physiology × form families; nonmonotone responses between the far grid points of the lopsided knobs (u_h near a bound)",
  "adr_order": "an ADR item ranks higher the more of its evidence is 'needs a rule', the larger the gap that remains, and the more a partial reach costs Level 0",
  "held_out": "held-out descriptors are measured and written because this is a reachability experiment, not a fit (the user, 2026-11-04); the v3 hold-out rule is unaffected"
 },
